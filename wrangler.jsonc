{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nymthesis-bridge",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "bridge.nymthesis.xyz",
      "custom_domain": true
    }
  ]
}
